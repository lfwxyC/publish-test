{
  "name": "emma-package-publish-lab-local",
  "version": "0.1.1",
  "description": "A minimal Node.js package for learning the publishing workflow",
  "type": "commonjs",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check src/index.js",
    "test": "node --test",
    "prepack": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lfwxyC/publish-test.git",
    "directory": "node"
  }
}
